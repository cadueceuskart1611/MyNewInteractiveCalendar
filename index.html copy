<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Family Shared Calendar</title>
    <style>
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background-color: #f5f5f7;
            padding: 15px;
            max-width: 1200px;
            margin: 0 auto;
        }
        .controls { display: flex; gap: 10px; margin-bottom: 20px; }
        select, button { padding: 8px 12px; font-size: 16px; border-radius: 8px; border: 1px solid #d2d2d7; background: white; }
        button { background: #0071e3; color: white; border: none; cursor: pointer; font-weight: bold; }
        .weekdays { display: grid; grid-template-columns: repeat(7, 1fr); text-align: center; font-weight: bold; background: #e8e8ed; padding: 10px 0; border-radius: 8px 8px 0 0; }
        .calendar-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 1px; background: #d2d2d7; border: 1px solid #d2d2d7; border-radius: 0 0 8px 8px; overflow: hidden; }
        .day-box { background: white; min-height: 140px; padding: 8px; display: flex; flex-direction: column; gap: 4px; }
        .day-number { font-weight: 600; font-size: 14px; }
        .day-box textarea { width: 100%; height: 28px; border: 1px solid #e8e8ed; border-radius: 4px; padding: 2px; font-size: 12px; resize: none; outline: none; box-sizing: border-box; background: #fafafa; }
        .day-box textarea:focus { border-color: #0071e3; background: white; }
        .empty-box { background: #f5f5f7; }
        .status-banner { background: #e3f2fd; color: #0d47a1; padding: 10px; border-radius: 8px; margin-bottom: 15px; display: none; font-weight: 500; text-align: center; }
    </style>
</head>
<body>

    <h1>Family Shared Calendar</h1>
    <div id="status" class="status-banner">Syncing...</div>

    <div class="controls">
        <select id="monthSelect"></select>
        <select id="yearSelect"></select>
        <button onclick="saveScheduleToGitHub()">Cloud Sync Changes</button>
    </div>

    <div class="weekdays">
        <div>Sun</div><div>Mon</div><div>Tue</div><div>Wed</div><div>Thu</div><div>Fri</div><div>Sat</div>
    </div>
    <div id="calendarGrid" class="calendar-grid"></div>

    <script>
        // CONFIGURATION: Fill these out with your information
        const GITHUB_TOKEN = 'PASTE_YOUR_COPIED_TOKEN_HERE';
        const GITHUB_USER = 'YOUR_GITHUB_USERNAME';
        const REPO_NAME = 'YOUR_REPOSITORY_NAME';
        const FILE_PATH = 'schedule-data.json'; // The file where everyone's data lives

        let scheduleDatabase = {}; 
        let currentSha = null;

        const monthSelect = document.getElementById('monthSelect');
        const yearSelect = document.getElementById('yearSelect');
        const calendarGrid = document.getElementById('calendarGrid');
        const statusBanner = document.getElementById('status');

        const months = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
        
        // Build Dropdowns
        months.forEach((m, idx) => { let o = document.createElement('option'); o.value = idx; o.textContent = m; monthSelect.appendChild(o); });
        for (let y = 2020; y <= 2200; y++) { let o = document.createElement('option'); o.value = y; o.textContent = y; yearSelect.appendChild(o); }
        monthSelect.value = new Date().getMonth();
        yearSelect.value = new Date().getFullYear();

        // PULL GLOBAL DATA FROM GITHUB REPOSITORY
        async function fetchScheduleFromGitHub() {
            showStatus("Downloading family schedule...");
            const url = `https://github.com{GITHUB_USER}/${REPO_NAME}/contents/${FILE_PATH}`;
            try {
                let response = await fetch(url, { headers: { 'Authorization': `token ${GITHUB_TOKEN}` } });
                // NEW SECURE CONFIGURATION
let GITHUB_TOKEN = localStorage.getItem('family_calendar_secret_token');
const GITHUB_USER = 'cadueceuskart1611'; // Put your real username here
const REPO_NAME = 'MyNewInteractiveCalendar';   // Put your real repository name here
const FILE_PATH = 'schedule-data.json';
                    const GITHUB_TOKEN = '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'
                    const GITHUB_USER = 'cadueceuskart1611'
                    const REPO_NAME = 'MyNewInteractiveCalendar'
                    let data = await response.json();
                    currentSha = data.sha; // Save tracking hash ID
                    scheduleDatabase = JSON.parse(atob(data.content)); // Decode text storage file
                    showStatus("Schedule up to date!", 3000);
                } else {
                    showStatus("Starting fresh calendar database...", 3000);
                }
            } catch (e) {
                showStatus("Error connecting to cloud.", 4000);
            }
            generateCalendar();
        }

        // PUSH LIVE UPDATES TO YOUR REPOSITORY
        async function saveScheduleToGitHub() {
            showStatus("Saving changes to family cloud...");
            const url = `https://github.com{GITHUB_USER}/${REPO_NAME}/contents/${FILE_PATH}`;
            
            // Gather all current screen inputs into database object
            document.querySelectorAll('.day-box textarea').forEach(tx => {
                if(tx.value.trim() !== "") scheduleDatabase[tx.id] = tx.value;
            });

            const contentEncoded = btoa(JSON.stringify(scheduleDatabase, null, 2));
            const body = {
                message: "Family calendar update via mobile site",
                content: contentEncoded,
                sha: currentSha
            };

            let response = await fetch(url, {
                method: 'PUT',
                headers: { 'Authorization': `token ${GITHUB_TOKEN}`, 'Content-Type': 'application/json' },
                body: JSON.stringify(body)
            });

            if (response.ok) {
                let data = await response.json();
                currentSha = data.content.sha; // Refresh file SHA identifier
                showStatus("Saved successfully!", 3000);
            } else {
                showStatus("Save conflict! Refresh and try again.", 5000);
            }
        }

        function generateCalendar() {
            calendarGrid.innerHTML = '';
            const selectedMonth = parseInt(monthSelect.value);
            const selectedYear = parseInt(yearSelect.value);

            const firstDayIndex = new Date(selectedYear, selectedMonth, 1).getDay();
            const totalDays = new Date(selectedYear, selectedMonth + 1, 0).getDate();

            for (let i = 0; i < firstDayIndex; i++) {
                let e = document.createElement('div'); e.classList.add('day-box', 'empty-box'); calendarGrid.appendChild(e);
            }

            for (let day = 1; day <= totalDays; day++) {
                let dayDiv = document.createElement('div');
                dayDiv.classList.add('day-box');

                const key1 = `n-${selectedYear}-${selectedMonth}-${day}-t1`;
                const key2 = `n-${selectedYear}-${selectedMonth}-${day}-t2`;
                const key3 = `n-${selectedYear}-${selectedMonth}-${day}-t3`;

                dayDiv.innerHTML = `
                    <div class="day-number">${day}</div>
                    <textarea placeholder="Task 1..." id="${key1}">${scheduleDatabase[key1] || ''}</textarea>
                    <textarea placeholder="Task 2..." id="${key2}">${scheduleDatabase[key2] || ''}</textarea>
                    <textarea placeholder="Task 3..." id="${key3}">${scheduleDatabase[key3] || ''}</textarea>
                `;
                calendarGrid.appendChild(dayDiv);
            }
        }

        function showStatus(text, duration = null) {
            statusBanner.innerText = text;
            statusBanner.style.display = 'block';
            if (duration) setTimeout(() => { statusBanner.style.display = 'none'; }, duration);
        }

        monthSelect.addEventListener('change', generateCalendar);
        yearSelect.addEventListener('change', generateCalendar);
        
        // Initialize download on start
        fetchScheduleFromGitHub();
    </script>
</body>
</html>
